<HEADER>
#
#         TABLE: heasarc_fermilgrb
#      LOCATION: dbms1.gsfc.nasa.gov:heasarcprod
#    TOTAL ROWS: 231
#
# CREATION DATE: 2022-06-22 16:49:38
# LAST MODIFIED: 2025-10-23 19:58:31
#   EXGEST DATE: 2025-10-23 20:51:35
#
table_name = heasarc_fermilgrb
table_description = "Fermi LAT Second Gamma-Ray Burst Catalog"
table_document_url = http://heasarc.gsfc.nasa.gov/W3Browse/fermi/fermilgrb.html
table_security = public
#
# Table Parameters
#
field[name] = char16  [meta.id;meta.main] (index) // Designation of the GRB in yymmddfff Format
field[gcn_name] = char16  [meta.id] (index) // Designation in the GCN Distribution List
field[time] = float8:.7f_mjd [time.start;obs]  // Date/Time of the Trigger
field[trigger_met] = float8:.5f_s [time.start;obs]  // Date/Time of the Trigger in Fermi Mission Elapsed Time
field[ra] = float8:.4f_degree [pos.eq.ra;meta.main] (key) // Right Ascension
field[dec] = float8:.4f_degree [pos.eq.dec;meta.main] (key) // Declination
field[lii] = float8:.4f_degree [pos.galactic.lon] (index) // Galactic Longitude
field[bii] = float8:.4f_degree [pos.galactic.lat] (index) // Galactic Latitude
field[error_radius] = float8:.4f_degree [stat.error;pos]  // Localization Error from LAT Transient Factory Analysis
field[redshift] = float8:.5f  [src.redshift]  // Redshift of the GRB (If Available)
field[luminosity_distance] = float8:.5e_cm [pos.distance]  // Luminosity Distance Calculated Using the Redshift of the GRB
field[theta] = float8:.4f_degree [pos]  // Off-Axis Angle at the Time of the Trigger
field[zenith] = float8:.4f_degree [pos]  // Zenith Angle at the Time of the Trigger
field[arr_flag] = int2  [meta.code;obs]  // Set to 1 If the GRB Triggered an Autonomous Repoint Request
field[distance_to_closest] = float8:.4f_degree [pos.angDistance]  // Distance to the Closest 3FGL Source
field[irfs] = char30  [instr.calib;meta.file]  // Instrument Response Function Used in the Analysis
field[lle_bbbd_sig] = float8:.4f_sigma [stat.fit.goodness;instr.background]  // Significance in LAT Low Energy (LLE) Data Using Bayesian Blocks Burst Detection
field[lle_bbbd_sig_detected] = int2  [meta.number]  // Whether the GRB Is Detected in LLE Data
field[lle_t05] = float8:.5f_s [time.start]  // LLE Onset Time
field[lle_t90] = float8:.5f_s [time.duration]  // LLE Duration Time
field[lle_t95] = float8:.5f_s [time.end]  // LLE End Time
field[tl0] = float8:.5f_s [time.start]  // LAT Emission Estimated Onset Time
field[tl100] = float8:.5f_s [time.duration]  // LAT Emission Estimated Duration
field[tl100_error] = float8:.5f_s [stat.error;time.duration]  // Error on the LAT Emission Duration
field[tl1] = float8:.5f_s [time.end]  // LAT Emission Estimated End
field[tl0_lower] = float8:.5f_s [time.start;stat.min]  // Estimated Lower Limit on the LAT Emission Onset Time
field[tl1_upper] = float8:.5f_s [time.end;stat.max]  // Estimated Upper Limit on LAT Emission End
field[like_best_t0] = float8:.5f_s [time.start]  // Start of the Time Window That Returned the Highest Value of Test Statistics
field[like_best_t1] = float8:.5f_s [time.end]  // End of the Time Window That Returned the Highest Value of Test Statistics
field[like_best_ts] = float8:.5e  [stat.likelihood]  // Value of the Test Statistics That Returned the Highest Value of Test Statistics
field[like_best_flux] = float8:.5e_photon/cm^2/s [phot.flux;em.gamma]  // Flux That Returned the Highest Value of Test Statistics
field[like_best_flux_error] = float8:.5e_photon/cm^2/s [stat.error;phot.flux;em.gamma]  // Error on the Flux That Returned the Highest Value of Test Statistics
field[like_best_flux_ene] = float8:.5e_erg/cm^2/s [phys.flux.energy;em.gamma]  // Energy Flux That Returned the Highest Value of Test Statistics
field[like_best_flux_ene_error] = float8:.5e_erg/cm^2/s [stat.error;phys.flux.energy;em.gamma]  // Error on the Energy Flux That Returned the Highest Value of Test Statistics
field[like_best_fluence] = float8:.5e_erg/cm^2 [phot.fluence;em.gamma]  // Energy Fluence That Returned the Highest Value of Test Statistics
field[like_best_fluence_error] = float8:.5e_erg/cm^2 [stat.error;phot.flux;em.gamma]  // Error on the Energy Fluence That Returned the Highest Value of Test Statistics
field[like_best_grbindex] = float8:.5e  [stat.fit.param]  // Photon Index of the Power Law Model That Returned the Highest TS Value
field[like_best_grbindex_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the Photon Index of the Power Law Model
field[like_best_eiso_rf] = float8:.5e_erg [em.energy]  // Rest Frame Isotropic Energy from 0.1-10 GeV from 0.1-10 GeV
field[like_best_eiso_rf_error] = float8:.5e_erg [stat.error;em.energy]  // Error on the Rest Frame Isotropic Energy from 0.1-10 GeV
field[like_lat_t0] = float8:.5f_s [time.start]  // Start of the Time Window in the LAT Time Window
field[like_lat_t1] = float8:.5f_s [time.end]  // End of the Time Window in the LAT Time Window
field[like_lat_ts] = float8:.5e  [stat.likelihood]  // Value of the Test Statistics in the LAT Time Window
field[like_lat_flux] = float8:.5e_photon/cm^2/s [phot.flux;em.gamma]  // Flux in the LAT Time Window
field[like_lat_flux_error] = float8:.5e_photon/cm^2/s [stat.error;phot.flux;em.gamma]  // Error on the Flux in the LAT Time Window
field[like_lat_flux_ene] = float8:.5e_erg/cm^2/s [phys.flux.energy;em.gamma]  // Energy Flux in the LAT Time Window
field[like_lat_flux_ene_error] = float8:.5e_erg/cm^2/s [stat.error;phys.flux.energy;em.gamma]  // Error on the Energy Flux in the LAT Time Window
field[like_lat_fluence] = float8:.5e_erg/cm^2 [phot.fluence;em.gamma]  // Energy Fluence in the LAT Time Window
field[like_lat_fluence_error] = float8:.5e_erg/cm^2 [stat.error;phot.flux;em.gamma]  // Error on the Energy Fluence in the LAT Time Window
field[like_lat_grbindex] = float8:.5e  [stat.fit.param]  // Photon Index of the Power Law Model in the LAT Time Window
field[like_lat_grbindex_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the Photon Index of the Power Law Model in the LAT Time Window
field[like_lat_eiso_rf] = float8:.5e_erg [em.energy]  // Rest Frame Isotropic Energy from 0.1-10 GeV in the LAT Time Window
field[like_lat_eiso_rf_error] = float8:.5e_erg [stat.error;em.energy]  // Error on the Rest Frame Isotropic Energy from 0.1-10 GeV in the LAT Time Window
field[like_gbm_t0] = float8:.5f_s [time.start]  // Start of the Time Window in the GBM Time Window
field[like_gbm_t1] = float8:.5f_s [time.end]  // End of the Time Window in the GBM Time Window
field[like_gbm_ts] = float8:.5e  [stat.likelihood]  // Value of the Test Statistics in the GBM Time Window
field[like_gbm_flux] = float8:.5e_photon/cm^2/s [phot.flux;em.gamma]  // Flux in the GBM Time Window
field[like_gbm_flux_error] = float8:.5e_photon/cm^2/s [stat.error;phot.flux;em.gamma]  // Error on the Flux in the GBM Time Window
field[like_gbm_flux_ene] = float8:.5e_erg/cm^2/s [phys.flux.energy;em.gamma]  // Energy Flux in the GBM Time Window
field[like_gbm_flux_ene_error] = float8:.5e_erg/cm^2/s [stat.error;phys.flux.energy;em.gamma]  // Error on the Energy Flux in the GBM Time Window
field[like_gbm_fluence] = float8:.5e_erg/cm^2 [phot.fluence;em.gamma]  // Energy Fluence in the GBM Time Window
field[like_gbm_fluence_error] = float8:.5e_erg/cm^2 [stat.error;phot.flux;em.gamma]  // Error on the Energy Fluence in the GBM Time Window
field[like_gbm_grbindex] = float8:.5e  [stat.fit.param]  // Photon Index of the Power Law Model in the GBM Time Window
field[like_gbm_grbindex_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the Photon Index of the Power Law Model in the GBM Time Window
field[like_gbm_eiso_rf] = float8:.5e_erg [em.energy]  // Rest Frame Isotropic Energy from 0.1-10 GeV in the GBM Time Window
field[like_gbm_eiso_rf_error] = float8:.5e_erg [stat.error;em.energy]  // Error on the Rest Frame Isotropic Energy from 0.1-10 GeV in the GBM Time Window
field[like_ext_t0] = float8:.5f_s [time.start]  // Start of the Time Window in the Ext Time Window
field[like_ext_t1] = float8:.5f_s [time.end]  // End of the Time Window in the Ext Time Window
field[like_ext_ts] = float8:.5e  [stat.likelihood]  // Value of the Test Statistics in the Ext Time Window
field[like_ext_flux] = float8:.5e_photon/cm^2/s [phot.flux;em.gamma]  // Flux in the Ext Time Window
field[like_ext_flux_error] = float8:.5e_photon/cm^2/s [stat.error;phot.flux;em.gamma]  // Error on the Flux in the Ext Time Window
field[like_ext_flux_ene] = float8:.5e_erg/cm^2/s [phys.flux.energy;em.gamma]  // Energy Flux in the Ext Time Window
field[like_ext_flux_ene_error] = float8:.5e_erg/cm^2/s [stat.error;phys.flux.energy;em.gamma]  // Error on the Energy Flux in the Ext Time Window
field[like_ext_fluence] = float8:.5e_erg/cm^2 [phot.fluence;em.gamma]  // Energy Fluence in the Ext Time Window
field[like_ext_fluence_error] = float8:.5e_erg/cm^2 [stat.error;phot.flux;em.gamma]  // Error on the Energy Fluence in the Ext Time Window
field[like_ext_grbindex] = float8:.5e  [stat.fit.param]  // Photon Index of the Power Law Model in the Ext Time Window
field[like_ext_grbindex_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the Photon Index of the Power Law Model in the Ext Time Window
field[like_ext_eiso_rf] = float8:.5e_erg [em.energy]  // Rest Frame Isotropic Energy from 0.1-10 GeV in the Ext Time Window
field[like_ext_eiso_rf_error] = float8:.5e_erg [stat.error;em.energy]  // Error on the Rest Frame Isotropic Energy from 0.1-10 GeV in the Ext Time Window
field[ext_emission_max_ene] = float8:.2f_MeV [em.energy]  // Maximum Energy of the Event with >90% Probability Associated with the GRB
field[ext_emission_max_ene_p] = float8:.2f  [stat.probability]  // Probability of the Event with Maximum Energy
field[ext_emission_max_ene_t] = float8:.5f_s [time.epoch]  // Arrival Time of the Event with Maximum Energy
field[ext_emission_n] = float8:.2f  [meta.number]  // Number of Events with Probability >90% Associated with the GRB
field[lat_bpl_chi2] = float8:.5e  [stat.fit.chi2]  // Chi^2 Obtained By Fitting the LAT Light Curve with a Broken Power Law Model
field[lat_bpl_f0] = float8:.5e  [stat.fit.param]  // Normalization of the Broken Power Law Model
field[lat_bpl_f0_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the Normalization of the Broken Power Law Model
field[lat_bpl_index1] = float8:.5e  [stat.fit.param]  // First Index of the Broken Power Law Model
field[lat_bpl_index1_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the First Index of the Broken Power Law Model
field[lat_bpl_index2] = float8:.5e  [stat.fit.param]  // Second Index of the Broken Power Law Model
field[lat_bpl_index2_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the Second Index of the Broken Power Law Model
field[lat_bpl_timebreak] = float8:.5e_s [stat.fit.param]  // Time of the Break
field[lat_bpl_timebreak_error] = float8:.5e_s [stat.error;stat.fit.param]  // Error on the Time of the Break
field[lat_spl_chi2] = float8:.5e  [stat.fit.chi2]  // Chi^2 Obtained By Fitting the LAT Light Curve with a Simple Power Law Model
field[lat_spl_index1] = float8:.5e  [stat.fit.param]  // Index of the Simple Power Law Model
field[lat_spl_index1_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the Index of the Simple Power Law Model
field[lat_f0] = float8:.5e  [stat.fit.param]  // Normalization of the Simple Power Law Model
field[lat_f0_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the Normalization of the Simple Power Law Model
field[late_index] = float8:.5e  [stat.fit.param]  // Index That Best Describe the Behavior at Late Time (BPL or SPL Index1)
field[late_index_error] = float8:.5e  [stat.error;stat.fit.param]  // Error on the Index That Best Describe the Behavior at Late Time
field[su_tsinput] = float8:.5e  [stat.likelihood]  // Test Statistic Resulting from the LAT Transient Factory Detection Algorithm
field[gbm_cat_name] = char12  [meta.id]  // Designation of the GRB in the Fermi GBM GRB Catalog
field[gbm_cat_t05] = float8:.3f_s [time.interval]  // GBM T05, When Available or 0
field[gbm_cat_t90] = float8:.3f_s [time.interval]  // GBM T90, When Available or the Estimated Duration of the Prompt Emission
field[gbm_cat_t90_error] = float8:.5f_s [stat.error;time.interval]  // Error on the GBM T90 from the Fermi GBM GRB Catalog
field[gbm_cat_t95] = float8:.3f_s [time.interval]  // Calclated As gbm_cat_t05+gbm_cat_t05
field[gbm_cat_fluence] = float8:.5e_erg/cm^2 [phot.fluence;em.gamma]  // Fluence in the 10 keV-1 MeV Energy Band, from the Fermi GBM GRB Catalog
field[gbm_cat_fluence_error] = float8:.5e_erg/cm^2 [stat.error;phot.flux;em.gamma]  // Error on the Fluence in the 10 KeV-1 MeV Energy Band
#
parameter_defaults = name time ra dec error_radius lle_bbbd_sig lle_t90 tl100 like_best_ts
#
# Virtual Parameters
#
catalog_bibcode = 2019ApJ...878...52A
declination = @dec
default_search_radius = 60
equinox = 2000
frequency_regime = Gamma-ray
observatory_name = FERMI
right_ascension = @ra
row_type = GRB
start_time = @time
table_author = Fermi LAT Team
table_priority = 5
table_type = Object
target_name = @name
unique_key = name
#
# Data Format Specification
#
line[1] = name gcn_name time trigger_met ra dec lii bii error_radius redshift luminosity_distance theta zenith arr_flag distance_to_closest irfs lle_bbbd_sig lle_bbbd_sig_detected lle_t05 lle_t90 lle_t95 tl0 tl100 tl100_error tl1 tl0_lower tl1_upper like_best_t0 like_best_t1 like_best_ts like_best_flux like_best_flux_error like_best_flux_ene like_best_flux_ene_error like_best_fluence like_best_fluence_error like_best_grbindex like_best_grbindex_error like_best_eiso_rf like_best_eiso_rf_error like_lat_t0 like_lat_t1 like_lat_ts like_lat_flux like_lat_flux_error like_lat_flux_ene like_lat_flux_ene_error like_lat_fluence like_lat_fluence_error like_lat_grbindex like_lat_grbindex_error like_lat_eiso_rf like_lat_eiso_rf_error like_gbm_t0 like_gbm_t1 like_gbm_ts like_gbm_flux like_gbm_flux_error like_gbm_flux_ene like_gbm_flux_ene_error like_gbm_fluence like_gbm_fluence_error like_gbm_grbindex like_gbm_grbindex_error like_gbm_eiso_rf like_gbm_eiso_rf_error like_ext_t0 like_ext_t1 like_ext_ts like_ext_flux like_ext_flux_error like_ext_flux_ene like_ext_flux_ene_error like_ext_fluence like_ext_fluence_error like_ext_grbindex like_ext_grbindex_error like_ext_eiso_rf like_ext_eiso_rf_error ext_emission_max_ene ext_emission_max_ene_p ext_emission_max_ene_t ext_emission_n lat_bpl_chi2 lat_bpl_f0 lat_bpl_f0_error lat_bpl_index1 lat_bpl_index1_error lat_bpl_index2 lat_bpl_index2_error lat_bpl_timebreak lat_bpl_timebreak_error lat_spl_chi2 lat_spl_index1 lat_spl_index1_error lat_f0 lat_f0_error late_index late_index_error su_tsinput gbm_cat_name gbm_cat_t05 gbm_cat_t90 gbm_cat_t90_error gbm_cat_t95 gbm_cat_fluence gbm_cat_fluence_error
